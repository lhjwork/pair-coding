{
  "name": "pair-coding",
  "displayName": "Pair Coding",
  "description": "AI와 한 줄씩 번갈아 짜는 페어 코딩 — 내 차례·정답·기초→응용을 에디터 줄 위에 바로 표시",
  "version": "0.4.0",
  "publisher": "lhjwork",
  "license": "MIT",
  "repository": "https://github.com/lhjwork/pair-coding",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Education", "AI"],
  "activationEvents": ["workspaceContains:.pair/turn.json", "onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "pair.say", "title": "Pair: AI에게 말하기" },
      { "command": "pair.peek", "title": "Pair: 정답 보기" }
    ]
  }
}
